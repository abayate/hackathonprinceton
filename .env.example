# Run from the repository: cd web && DATA_MODE=public npm run dev
# Set DATA_MODE in the shell or web/.env.local. Copying this file to the
# repository root .env alone does not set Next's process environment.
# Public Texas project demo without credentials or sponsor data:
DATA_MODE=public

# Optional private session evidence intake. Off unless exactly true.
# Submitted quotes are matched to public HTTPS text; dates and claims are not verified.
# Local demonstration only: keep intake OFF on public deployments until a durable
# rate limit uses an identity the caller cannot reset. Cookie limits are resettable;
# the global process cap alone does not protect availability across visitors/instances.
# ENABLE_EVIDENCE_INTAKE=true

# Optional AI-assisted source research for local demonstrations only.
# Requires an explicitly enabled investigator and a server-side Gemini key.
# The live Gemini adapter has not been tested against the live service.
# Keep the investigator disabled on public deployments until durable,
# non-resettable visitor limits and shared storage are in place.
# ENABLE_INVESTIGATOR=true
# GEMINI_API_KEY=

# For database mode, remove DATA_MODE and set DATABASE_URL in your local .env.
# Do not commit real values. The empty examples below are intentionally inactive.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# VEXCEL_API_KEY=
# Vexcel redirects are followed only on HTTPS to the exact API origin (up to 2 hops); cross-host redirects are refused.
# Provider redirect behavior is untested live. Confirm the provider contract before adding any future hostname allowlist.
# Optional per-process 3D Vexcel proxy request ceiling (default 600; accepted range 1-10000).
# Unset or invalid values fall back to 600. This is not a durable or shared limit across workers.
# VEXCEL_REQUESTS_PER_MINUTE=600
# GOOGLE_API_KEY=
# CACHE_DIR=
